# SkillXGen environment — copy to .env.local and fill in. NEVER commit real values.
# Everything except DATABASE_URL is optional for local development.

# ── Core ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgres://skillxgen:skillxgen_dev@127.0.0.1:5432/skillxgen
# Set to "require" for hosted Postgres (Supabase / Neon / RDS)
DATABASE_SSL=

# ── Authentication ───────────────────────────────────────────────────
# "clerk" (production) or "local" (development / automated tests only).
# Defaults to clerk when Clerk keys are present, otherwise local outside production.
AUTH_PROVIDER=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Local adapter: random 32+ char secret used to sign session cookies.
LOCAL_AUTH_SECRET=
# CI only: allows the local adapter under NODE_ENV=production (next start). Never set on a real deployment.
LOCAL_AUTH_ALLOW_PRODUCTION=

# ── File storage ─────────────────────────────────────────────────────
# "local" (filesystem, .data/uploads) or "supabase" (Supabase Storage, private bucket)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=skillxgen-private

# ── AI provider (optional) ───────────────────────────────────────────
# "anthropic" | "openai-compatible" | "none". Tools fall back to rule-based analysis when unset.
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# ── Payments (Stripe TEST mode) ──────────────────────────────────────
# "stripe" or "mock". Defaults to stripe when a key is present, otherwise mock outside production.
PAYMENTS_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Live keys (sk_live_…) are rejected unless this is exactly "true".
STRIPE_LIVE_MODE_ENABLED=false

# ── Email ────────────────────────────────────────────────────────────
# Without RESEND_API_KEY all email is stored in the admin outbox instead of being sent.
RESEND_API_KEY=
EMAIL_FROM="SkillXGen <no-reply@example.com>"

# ── Automation / marketing (optional) ────────────────────────────────
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
POSTIZ_API_URL=
POSTIZ_API_KEY=
TWENTY_API_URL=
TWENTY_API_KEY=

# ── Analytics / scheduling (optional) ────────────────────────────────
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_CALCOM_LINK=
